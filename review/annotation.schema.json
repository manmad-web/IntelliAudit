        }
      },
      "required": [
        "document_id",
        "source_kind",
        "accession",
        "source_url",
        "sha256",
        "retrieved_at",
        "document_date",
        "available_at",
        "initially_visible",
        "obtainable",
        "is_synthetic",
        "rights_status",
        "provenance_note"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
