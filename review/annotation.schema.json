        "cell_id",
        "document_id",
        "locator",
        "raw_value",
        "normalized_value",
        "unit",
        "currency",
        "scale_factor",
        "sign_convention",
        "period_kind",
        "period_start",
        "period_end",
        "transformation",
        "verified_against_selected_source"
      ],
      "additionalProperties": false
    },
