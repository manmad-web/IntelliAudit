{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intelliaudit:annotation:0.1.0",
  "title": "Financial reporting assertion annotation (single-expert protocol; human review required)",
  "description": "Structure is distinct from accounting validity. Nulls and empty lists preserve unknowns in drafts. The companion validator enforces cross-record and release gates.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "annotation_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "needs_resolution",
        "expert_reviewed",
        "excluded"
      ]
    },
    "release_status": {
      "enum": [
        "development_only",
        "candidate",
        "eligible"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "framework": {
          "enum": [
            "us_gaap",
            "ifrs",
            "experimental_only"
          ]
        },
        "jurisdiction": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "assertion_family": {
          "enum": [
            "revenue_cutoff",
            "inventory_measurement",
            "current_classification",
            "other"
          ]
        },
        "assertion": {
          "type": "string"
        },
        "entity_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "reporting_period_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reporting_period_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "investigation_cutoff": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_case_kind": {
          "enum": [
            "source_grounded",
            "synthetic",
            "hybrid"
          ]
        },
        "synthetic_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "scope_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "framework",
        "jurisdiction",
        "assertion_family",
        "assertion",
        "entity_type",
        "reporting_period_start",
        "reporting_period_end",
        "investigation_cutoff",
        "source_case_kind",
        "synthetic_assumptions",
        "scope_limitations"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_document"
      },
      "minItems": 0
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      },
      "minItems": 0
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "minItems": 0
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authority"
      },
      "minItems": 0
    },
    "proof_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proof"
      },
      "minItems": 0
    },
    "gold": {
      "$ref": "#/$defs/gold"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewer"
      },
      "minItems": 0
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "minItems": 0
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "review_plan": {
      "type": "object",
      "properties": {
        "model": {
          "const": "single_expert_review"
        },
        "repeat_required": {
          "type": "boolean"
        },
        "minimum_repeat_delay_days": {
          "type": "integer",
          "minimum": 7
        },
        "repeat_selection_frozen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "repeat_strata": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "manual_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "repeat_required",
        "minimum_repeat_delay_days",
        "repeat_selection_frozen_at",
        "repeat_strata",
        "manual_version"
      ],
      "additionalProperties": false
    },
    "leakage_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 0
    },
    "split": {
      "type": "object",
      "properties": {
        "company_group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "filing_group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "event_group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "pair_group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "assignment": {
          "enum": [
            "unassigned",
            "development",
            "validation",
            "test"
          ]
        },
        "freeze_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "frozen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "protocol_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "initial_view_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "observable_bundle_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "company_group_ids",
        "filing_group_ids",
        "event_group_ids",
        "pair_group_ids",
        "assignment",
        "freeze_id",
        "frozen_at",
        "protocol_sha256",
        "initial_view_sha256",
        "observable_bundle_sha256"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "annotation_id",
    "case_id",
    "status",
    "release_status",
    "scope",
    "sources",
    "cells",
    "facts",
    "authorities",
    "proof_sets",
    "gold",
    "reviewers",
    "reviews",
    "resolution",
    "review_plan",
    "leakage_checks",
    "split",
    "notes"
  ],
  "additionalProperties": false,
  "$defs": {
